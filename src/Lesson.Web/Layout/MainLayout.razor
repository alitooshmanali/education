@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Lesson.Web
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime Js


<style>
.umenu { position: relative; z-index: 60; }
.umenu__trigger {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 5px 12px 5px 6px; border-radius: 999px;
  border: 1px solid var(--line); background: var(--paper); cursor: pointer;
  font: inherit; color: inherit; max-width: 260px;
}
.umenu__trigger:hover { border-color: var(--navy-200); box-shadow: 0 2px 8px rgba(10,43,81,.06); }
.umenu__avatar {
  width: 32px; height: 32px; border-radius: 999px; flex-shrink: 0;
  display: inline-grid; place-items: center;
  background: var(--navy-50); color: var(--navy-800); font-size: 12px; font-weight: 800;
}
.umenu__meta { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; line-height: 1.3; }
.umenu__meta strong { font-size: 12.5px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 140px; }
.umenu__meta small { font-size: 10.5px; color: var(--muted); }
.umenu__caret { font-size: 10px; color: var(--muted); margin-inline-start: 2px; }
.umenu--open .umenu__caret { transform: rotate(180deg); }
.umenu__panel {
  position: absolute; top: calc(100% + 8px); inset-inline-end: 0;
  min-width: 220px; background: var(--paper); border: 1px solid var(--line);
  border-radius: 14px; box-shadow: 0 16px 40px rgba(10,43,81,.14);
  padding: 8px; z-index: 70;
}
.umenu__panel-head {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 10px 12px; border-bottom: 1px solid var(--line); margin-bottom: 6px;
}
.umenu__panel-head strong { display: block; font-size: 13px; font-weight: 800; }
.umenu__panel-head small { display: block; font-size: 11px; color: var(--muted); }
.umenu__logout {
  display: block; width: 100%; border: 0; background: transparent;
  text-align: start; padding: 10px 12px; border-radius: 10px;
  font: inherit; font-size: 13px; font-weight: 700; color: var(--coral); cursor: pointer;
}
.umenu__logout:hover { background: var(--coral-bg); }
.umenu__scrim {
  position: fixed; inset: 0; border: 0; padding: 0; margin: 0;
  background: transparent; cursor: default; z-index: 65;
}
</style>

<div class="app-shell @(ThemeClass) @(_isNavOpen ? "nav-open" : null)" dir="rtl" lang="fa">
    <aside class="app-sidebar @(_isNavOpen ? "is-open" : null)" data-open="@_isNavOpen" aria-label="Primary navigation">
        <div class="brand">
            <div class="brand__mark brand__mark--logo">
                <img src="/img/logo.png" alt="اساطیر آینده" />
            </div>
            <div class="brand__text">
                <strong>اساطیر آینده</strong>
                <span>پلتفرم آموزش آنلاین</span>
            </div>
        </div>

        <nav aria-label="Primary">
            @if (_isStudent)
            {
                <section class="nav-section">
                    <div class="nav-label">صفحه اصلی</div>
                    <NavLink class="nav-item" href="/student" Match="NavLinkMatch.All"><AppIcon Name="dashboard" /> داشبورد</NavLink>
                    <NavLink class="nav-item" href="/student/videos"><AppIcon Name="video" /> محتوا</NavLink>
                    <NavLink class="nav-item" href="/student/quizzes"><AppIcon Name="audit" /> آزمون‌ها</NavLink>
                </section>
            }
            else if (_isTeacher)
            {
                <section class="nav-section">
                    <div class="nav-label">پنل مدرس</div>
                    <NavLink class="nav-item" href="/teacher" Match="NavLinkMatch.All"><AppIcon Name="dashboard" /> داشبورد</NavLink>
                    <NavLink class="nav-item" href="/teacher/students"><AppIcon Name="users" /> دانش‌آموزان</NavLink>
                    <NavLink class="nav-item" href="/teacher/contents"><AppIcon Name="folder" /> محتوای آموزشی</NavLink>
                    <NavLink class="nav-item" href="/teacher/folders"><AppIcon Name="folder" /> پوشه‌ها</NavLink>
                    <NavLink class="nav-item" href="/teacher/videos"><AppIcon Name="video" /> ویدیو</NavLink>
                    <NavLink class="nav-item" href="/teacher/podcasts"><AppIcon Name="video" /> پادکست</NavLink>
                    <NavLink class="nav-item" href="/teacher/stories"><AppIcon Name="audit" /> داستان</NavLink>
                    <NavLink class="nav-item" href="/teacher/quizzes"><AppIcon Name="audit" /> آزمون‌ها</NavLink>
                    <NavLink class="nav-item" href="/teacher/reports"><AppIcon Name="audit" /> گزارش‌ها</NavLink>
                </section>
            }
            else if (_isAdmin)
            {
                <section class="nav-section nav-section--home">
                    <div class="nav-label">نمای کلی</div>
                    <NavLink class="nav-item" href="/admin" Match="NavLinkMatch.All"><AppIcon Name="dashboard" /> داشبورد مدیریت</NavLink>
                </section>

                <details class="nav-group" open>
                    <summary><AppIcon Name="users" /> مدیریت آموزشگاه <span class="nav-group__chevron">⌄</span></summary>
                    <div class="nav-group__links">
                        <NavLink class="nav-item" href="/admin/users"><AppIcon Name="users" /> کاربران و حساب‌ها</NavLink>
                        <NavLink class="nav-item" href="/admin/teachers"><AppIcon Name="users" /> مدرسان</NavLink>
                        <NavLink class="nav-item" href="/admin/classes"><AppIcon Name="folder" /> کلاس‌ها</NavLink>
                        <NavLink class="nav-item" href="/admin/schedule"><AppIcon Name="audit" /> برنامهٔ هفتگی</NavLink>
                        <NavLink class="nav-item nav-item--report" href="/admin/reports#academy"><AppIcon Name="chart" /> گزارش آموزشگاه</NavLink>
                    </div>
                </details>

                <details class="nav-group">
                    <summary><AppIcon Name="globe" /> مدیریت وب‌سایت <span class="nav-group__chevron">⌄</span></summary>
                    <div class="nav-group__links">
                        <NavLink class="nav-item" href="/admin/site-pages"><AppIcon Name="dashboard" /> صفحات و چیدمان سایت</NavLink>
                        <NavLink class="nav-item" href="/admin/site-library"><AppIcon Name="folder" /> کتابخانه و رسانه سایت</NavLink>
                        <NavLink class="nav-item" href="/admin/site-books"><AppIcon Name="folder" /> کتاب‌های سایت</NavLink>
                        <NavLink class="nav-item" href="/admin/site-courses"><AppIcon Name="folder" /> دوره‌های سایت</NavLink>
                        <NavLink class="nav-item nav-item--report" href="/admin/reports#website"><AppIcon Name="chart" /> گزارش وب‌سایت</NavLink>
                    </div>
                </details>

                <details class="nav-group">
                    <summary><AppIcon Name="layers" /> محتوا و آموزش <span class="nav-group__chevron">⌄</span></summary>
                    <div class="nav-group__links">
                        <NavLink class="nav-item" href="/admin/media"><AppIcon Name="upload" /> مرکز یکپارچه رسانه</NavLink>
                        <NavLink class="nav-item" href="/admin/contents"><AppIcon Name="video" /> محتوای پلتفرم</NavLink>
                        <NavLink class="nav-item" href="/admin/folders"><AppIcon Name="folder" /> پوشه‌های آموزشی</NavLink>
                        <NavLink class="nav-item" href="/admin/quizzes"><AppIcon Name="quiz" /> آزمون‌ها</NavLink>
                        <NavLink class="nav-item nav-item--report" href="/admin/reports#platform"><AppIcon Name="chart" /> گزارش محتوا و آموزش</NavLink>
                    </div>
                </details>

                <details class="nav-group">
                    <summary><AppIcon Name="chart" /> گزارش‌ها و ارزیابی <span class="nav-group__chevron">⌄</span></summary>
                    <div class="nav-group__links">
                        <NavLink class="nav-item" href="/admin/candidates"><AppIcon Name="users" /> گزارش داوطلبان تعیین سطح</NavLink>
                        <NavLink class="nav-item" href="/admin/audit"><AppIcon Name="audit" /> گزارش فعالیت‌های سیستم</NavLink>
                        <NavLink class="nav-item" href="/admin/placement-bank"><AppIcon Name="quiz" /> بانک سؤالات تعیین سطح</NavLink>
                        <NavLink class="nav-item nav-item--report" href="/admin/reports#assessment"><AppIcon Name="chart" /> گزارش ارزیابی‌ها</NavLink>
                    </div>
                </details>

                <details class="nav-group">
                    <summary><AppIcon Name="settings" /> تنظیمات و امنیت <span class="nav-group__chevron">⌄</span></summary>
                    <div class="nav-group__links">
                        <NavLink class="nav-item" href="/admin/permissions"><AppIcon Name="permission" /> نقش‌ها و دسترسی‌ها</NavLink>
                        <NavLink class="nav-item" href="/admin/devices"><AppIcon Name="device" /> دستگاه‌های متصل</NavLink>
                        <NavLink class="nav-item nav-item--report" href="/admin/reports#security"><AppIcon Name="chart" /> گزارش امنیت و فعالیت</NavLink>
                    </div>
                </details>
            }
            else
            {
                <section class="nav-section">
                    <NavLink class="nav-item" href="/login"><AppIcon Name="logout" /> ورود</NavLink>
                </section>
            }
        </nav>
    </aside>

    <div class="nav-backdrop" @onclick="CloseNav" role="button" aria-label="بستن منو"></div>

    <section class="app-main @(_isNavOpen ? "is-open" : string.Empty)">
        <header class="topbar">
            <div class="topbar__left">
                <button class="menu-toggle" type="button" @onclick="ToggleNav" aria-label="منو">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <div class="topbar__crumb">@(_pageTitle)</div>
            </div>

            <div class="topbar__right">
                @if (_isTeacher)
                {
                    <TeacherClassSelector />
                }
                <div class="umenu @(_userMenuOpen ? "umenu--open" : null)">
                    <button type="button" class="umenu__trigger" @onclick="ToggleUserMenu" aria-haspopup="true" aria-expanded="@_userMenuOpen">
                        <span class="umenu__avatar">@(_displayName?.FirstOrDefault())</span>
                        <span class="umenu__meta">
                            <strong>@_displayName</strong>
                            <small>@(_isAdmin ? "مدیر" : _isTeacher ? "مدرس" : _isStudent ? "دانشجو" : "کاربر")</small>
                        </span>
                        <span class="umenu__caret">▾</span>
                    </button>
                    @if (_userMenuOpen)
                    {
                        <div class="umenu__panel" role="menu">
                            <div class="umenu__panel-head">
                                <span class="umenu__avatar">@(_displayName?.FirstOrDefault())</span>
                                <div>
                                    <strong>@_displayName</strong>
                                    <small>@(_isAdmin ? "مدیر" : _isTeacher ? "مدرس" : _isStudent ? "دانشجو" : "کاربر")</small>
                                </div>
                            </div>
                            <button type="button" class="umenu__logout" role="menuitem" @onclick="LogoutFromMenu">خروج از حساب</button>
                        </div>
                        <button type="button" class="umenu__scrim" aria-label="بستن" @onclick="CloseUserMenu"></button>
                    }
                </div>
            </div>
        </header>
        @if (_navigationPending)
        {
            <div class="route-progress" role="status" aria-live="polite"><span></span><small>در حال باز کردن بخش…</small></div>
        }

        <main class="content">
            @Body
        </main>
    </section>
</div>

@code {
    private const string DefaultTheme = "system";
    private bool _isAdmin;
    private bool _isStudent;
    private bool _isTeacher;
    private string _displayName = "کاربر";
    private bool _isNavOpen;
    private bool _userMenuOpen;
    private bool _isDarkMode;
    private string _pageTitle = "Lesson";
    private string _themePreference = DefaultTheme;
    private bool _initializedTheme;
    private bool _navigationPending;
    private IDisposable? _locationChangingRegistration;

    private string ThemeClass => _isDarkMode ? "theme-dark" : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += HandleLocationChanged;
        _locationChangingRegistration = Nav.RegisterLocationChangingHandler(HandleLocationChanging);
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        _isAdmin = user.IsInRole(nameof(UserRole.Admin));
        _isStudent = user.IsInRole(nameof(UserRole.Student));
        _isTeacher = user.IsInRole(nameof(UserRole.Teacher));
        _displayName = user.Identity?.Name ?? "کاربر";
        _pageTitle = ResolvePageTitle(new Uri(Nav.Uri).AbsolutePath);
    }

    private ValueTask HandleLocationChanging(LocationChangingContext context)
    {
        _navigationPending = true;
        return new ValueTask(InvokeAsync(StateHasChanged));
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            _navigationPending = false;
            _isNavOpen = false;
            _userMenuOpen = false;
            _pageTitle = ResolvePageTitle(new Uri(args.Location).AbsolutePath);
            StateHasChanged();
        });
    }

    private string ResolvePageTitle(string path)
    {
        if (path.Equals("/admin", StringComparison.OrdinalIgnoreCase)) return "داشبورد مدیریت";
        if (path.StartsWith("/admin/media", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/admin/contents", StringComparison.OrdinalIgnoreCase)) return "مرکز رسانه و محتوا";
        if (path.StartsWith("/admin/site-", StringComparison.OrdinalIgnoreCase)) return "مدیریت وب‌سایت";
        if (path.StartsWith("/admin/users", StringComparison.OrdinalIgnoreCase)) return "کاربران و حساب‌ها";
        if (path.StartsWith("/admin/teachers", StringComparison.OrdinalIgnoreCase)) return "مدرسان";
        if (path.StartsWith("/admin/classes", StringComparison.OrdinalIgnoreCase)) return "کلاس‌ها";
        if (path.StartsWith("/admin/audit", StringComparison.OrdinalIgnoreCase)) return "گزارش فعالیت سیستم";
        if (path.StartsWith("/admin/reports", StringComparison.OrdinalIgnoreCase)) return "مرکز گزارش‌های پلتفرم";
        if (path.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase)) return "مدیریت پلتفرم";
        if (path.Equals("/teacher", StringComparison.OrdinalIgnoreCase)) return "داشبورد مدرس";
        if (path.StartsWith("/teacher/", StringComparison.OrdinalIgnoreCase)) return "فضای کاری مدرس";
        if (path.Equals("/student", StringComparison.OrdinalIgnoreCase)) return "داشبورد دانش‌آموز";
        if (path.StartsWith("/student/", StringComparison.OrdinalIgnoreCase)) return "فضای یادگیری";
        return _isAdmin ? "پنل مدیریت" : _isTeacher ? "پنل مدرس" : _isStudent ? "پنل دانش‌آموز" : "پلتفرم";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        _locationChangingRegistration?.Dispose();
    }

    private bool IsThemeActive(string theme) => string.Equals(_themePreference, theme, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initializedTheme)
        {
            _initializedTheme = true;
            try
            {
                var resolved = await Js.InvokeAsync<ThemeState>("lessonTheme.getState", DefaultTheme, 6);
                _themePreference = resolved.Preference;
                _isDarkMode = resolved.IsDark;
            }
            catch
            {
                _themePreference = DefaultTheme;
                _isDarkMode = false;
            }
            StateHasChanged();
        }
    }

    private async Task UpdateThemeAsync(string preference)
    {
        _themePreference = preference;
        try
        {
            _isDarkMode = await Js.InvokeAsync<bool>("lessonTheme.apply", preference);
            await Js.InvokeVoidAsync("lessonTheme.persist", preference);
        }
        catch
        {
            _isDarkMode = string.Equals(preference, "dark", StringComparison.OrdinalIgnoreCase);
        }
        StateHasChanged();
    }

    private Task SetThemeLight() => UpdateThemeAsync("light");
    private Task SetThemeDark() => UpdateThemeAsync("dark");
    private Task SetThemeSystem() => UpdateThemeAsync("system");

    private void ToggleNav() => _isNavOpen = !_isNavOpen;
    private void CloseNav() => _isNavOpen = false;
    private void Logout() => Nav.NavigateTo("/api/auth/logout", forceLoad: true);

    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;
    private void CloseUserMenu() => _userMenuOpen = false;

    private void LogoutFromMenu()
    {
        _userMenuOpen = false;
        Logout();
    }

    private sealed record ThemeState(bool IsDark, string Preference);
}