<article class="video-card">
    <div class="video-card__thumb">
        <AppIcon Name="@(IsVideo ? "video" : "folder")" />
    </div>
    <div class="video-card__body">
        <div class="video-card__title">@Content.DisplayName</div>
        <div class="video-card__meta ltr">@Content.FolderPath</div>
        <div class="video-card__foot">
            <span>@Content.FileExtension</span>
            <span>@FormatSize(Content.FileSize)</span>
            <span class="status-badge tone-neutral">@Content.Type</span>
        </div>
    </div>
    <a class="video-card__action" href="@Href">
        <AppIcon Name="play" />
        <span>باز کردن</span>
    </a>
</article>

@code {
    [Parameter] public ContentDto Content { get; set; } = default!;
    [Parameter] public string Href { get; set; } = "";

    private bool IsVideo => Content.Type is Lesson.Domain.Enums.ContentType.Video or Lesson.Domain.Enums.ContentType.Audio;

    private static string FormatSize(long size)
        => size > 1024 * 1024 * 1024 ? $"{size / 1024d / 1024d / 1024d:0.0} GB" :
           size > 1024 * 1024 ? $"{size / 1024d / 1024d:0.0} MB" :
           $"{size / 1024d:0.0} KB";
}
