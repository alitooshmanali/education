<section class="state-card state-card--error" role="alert">
    <span class="state-card__icon" aria-hidden="true">!</span>
    <div class="state-card__body">
        <h3>@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p>@Message</p>
        }
        @if (ChildContent is not null)
        {
            <div class="state-card__actions">@ChildContent</div>
        }
        else if (OnRetry.HasDelegate)
        {
            <button type="button" class="btn btn-primary" @onclick="OnRetry">تلاش دوباره</button>
        }
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "دریافت اطلاعات با مشکل روبه‌رو شد";
    [Parameter] public string Message { get; set; } = "لطفاً اتصال خود را بررسی کنید و دوباره تلاش کنید.";
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
