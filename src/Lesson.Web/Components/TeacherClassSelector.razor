@inject TeacherSessionState Session
@inject ITeacherWorkspaceService Workspace
@inject ICurrentUserContext Current
@implements IDisposable

<div class="tctx">
    <div class="tctx__field">
        <label>سطح</label>
        <select value="@_levelStr" @onchange="OnLevelInput">
            <option value="">سطح</option>
            @foreach (var lv in _levels)
            {
                <option value="@((int)lv.Level)">@lv.Level</option>
            }
        </select>
    </div>
    <div class="tctx__field tctx__field--wide">
        <label>کلاس</label>
        <select value="@_classStr" @onchange="OnClassInput" disabled="@(!_levels.Any() || string.IsNullOrEmpty(_levelStr))">
            <option value="">کلاس</option>
            @foreach (var c in _classes)
            {
                <option value="@c.Id">@c.Code</option>
            }
        </select>
    </div>
    @if (Session.SelectedClass is { } sc)
    {
        <span class="tctx__meta" title="@sc.Title">
            @string.Join("، ", sc.Days.Select(d => d.DayNameFa))
            · @($"{sc.StartTime.Hours:00}:{sc.StartTime.Minutes:00}")–@($"{sc.EndTime.Hours:00}:{sc.EndTime.Minutes:00}")
        </span>
    }
</div>

<style>
    .tctx {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: nowrap;
        margin-inline-end: 8px;
    }
    .tctx__field {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 88px;
    }
    .tctx__field--wide { min-width: 120px; }
    .tctx__field label {
        font-size: 10px;
        font-weight: 700;
        color: #6B7787;
        line-height: 1;
    }
    .tctx__field select {
        height: 34px;
        border: 1px solid #E6E1D6;
        border-radius: 999px;
        padding: 0 12px;
        font: inherit;
        font-size: 12.5px;
        font-weight: 700;
        color: #0A2B51;
        background: #fff;
        cursor: pointer;
        max-width: 150px;
    }
    .tctx__field select:disabled {
        opacity: .55;
        cursor: not-allowed;
    }
    .tctx__meta {
        font-size: 11px;
        color: #6B7787;
        white-space: nowrap;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    @@media (max-width: 900px) {
        .tctx__meta { display: none; }
    }

    @@media (max-width: 768px) {
        .tctx {
            flex-wrap: wrap;
            gap: 6px;
            margin-inline-end: 0;
            width: 100%;
        }
        .tctx__field { min-width: 0; flex: 1 1 40%; }
        .tctx__field--wide { flex: 1 1 45%; }
        .tctx__field select {
            max-width: 100%;
            width: 100%;
            height: 36px;
            font-size: 12px;
        }
        .tctx__meta {
            flex: 1 1 100%;
            max-width: 100%;
            font-size: 10.5px;
        }
    }
</style>

@code {
    private List<TeacherLevelOption> _levels = new();
    private List<ClassRoomDto> _classes = new();
    private string _levelStr = "";
    private string _classStr = "";
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await Current.EnsureInitializedAsync();
        Session.Changed += OnSessionChanged;
        if (Current.UserId is not long uid) return;

        _levels = (await Workspace.GetMyLevelsAsync(uid)).ToList();

        // restore or auto-pick first level
        if (Session.SelectedLevel is { } existing)
        {
            _levelStr = ((int)existing).ToString();
            _classes = (await Workspace.GetMyClassesAsync(uid, existing)).ToList();
        }
        else if (_levels.Count > 0)
        {
            var first = _levels[0].Level;
            _levelStr = ((int)first).ToString();
            Session.SetLevel(first);
            _classes = (await Workspace.GetMyClassesAsync(uid, first)).ToList();
        }

        if (Session.SelectedClassId is { } cid && _classes.Any(c => c.Id == cid))
        {
            _classStr = cid.ToString();
        }
        else if (_classes.Count > 0)
        {
            var firstClass = _classes[0];
            _classStr = firstClass.Id.ToString();
            Session.SetClass(firstClass);
        }

        _ready = true;
    }

    private async Task OnLevelInput(ChangeEventArgs e)
    {
        _levelStr = e.Value?.ToString() ?? "";
        _classStr = "";
        if (!int.TryParse(_levelStr, out var li))
        {
            Session.SetLevel(null);
            _classes = new();
            return;
        }
        var lv = (LanguageLevel)li;
        Session.SetLevel(lv);
        if (Current.UserId is long uid)
            _classes = (await Workspace.GetMyClassesAsync(uid, lv)).ToList();
        if (_classes.Count > 0)
        {
            _classStr = _classes[0].Id.ToString();
            Session.SetClass(_classes[0]);
        }
        else
        {
            Session.SetClass(null);
        }
    }

    private Task OnClassInput(ChangeEventArgs e)
    {
        _classStr = e.Value?.ToString() ?? "";
        if (!long.TryParse(_classStr, out var id))
        {
            Session.SetClass(null);
            return Task.CompletedTask;
        }
        var cls = _classes.FirstOrDefault(c => c.Id == id);
        Session.SetClass(cls);
        return Task.CompletedTask;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
