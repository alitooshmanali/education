@page "/login"
@layout AuthLayout
@inject NavigationManager Nav
@inject IJSRuntime JS

@code {
    private string? _error;
    private bool _showPassword;
    private bool _loginScriptInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loginScriptInitialized) return;
        _loginScriptInitialized = true;
        await JS.InvokeVoidAsync("asatirLogin.initialize");
    }

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("error", out var value))
        {
            _error = value.ToString();
        }
    }
}

<div class="auth-shell">
    <div class="auth-page">
        <section class="auth-hero">
            <div class="brand brand--auth">
                <div class="brand__mark brand__mark--logo"><img src="/img/logo.png" alt="اساطیر آینده" /></div>
                <div class="brand__text">
                    <strong>اساطیر آینده</strong>
                    <span>پلتفرم آموزش آنلاین</span>
                </div>
            </div>
            <h1>ورود به پلتفرم</h1>
            <p>برای دسترسی به پنل مدرس یا زبان‌آموز وارد شوید و مسیر یادگیری را ادامه دهید.</p>
            <div class="auth-hero__features" aria-label="قابلیت‌های پلتفرم">
                <span>مسیر یادگیری شخصی</span>
                <span>محتوای چندرسانه‌ای</span>
                <span>پیگیری پیشرفت</span>
            </div>
        </section>

        <section class="auth-card-wrap">
            <form class="auth-card" method="post" action="/api/auth/login" data-asatir-login novalidate>
                <h2>ورود به حساب</h2>
                <p class="sub">نام کاربری و رمز عبور خود را وارد کنید.</p>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-error" role="alert" aria-live="assertive">@_error</div>
                }

                <div class="form-grid">
                    <div class="field">
                        <label for="username">نام کاربری</label>
                        <input id="username" name="username" type="text" dir="ltr" autocomplete="username" autocapitalize="off" spellcheck="false" required placeholder="student01" />
                    </div>

                    <div class="field">
                        <label for="password">رمز عبور</label>
                            <div class="login-password-wrap">
                            <input id="password" name="password" type="@(_showPassword ? "text" : "password")" dir="ltr" autocomplete="current-password" required placeholder="رمز عبور" />
                            <button class="login-toggle-password" type="button" @onclick="() => _showPassword = !_showPassword" aria-label="نمایش/مخفی کردن رمز">
                                <AppIcon Name="@( _showPassword ? "eye-off" : "eye" )" />
                            </button>
                        </div>
                    </div>

                    <button class="btn btn-primary btn-compact auth-submit" type="submit"><AppIcon Name="shield" /> <span class="auth-submit__label">ورود</span><span class="auth-submit__spinner" aria-hidden="true"></span></button>
                    <p class="auth-submit__status" data-login-status role="status" aria-live="polite"></p>
                    <p class="sub" style="margin-top:1rem;text-align:center">
                        <a href="/site/index.html">بازگشت به وب‌سایت اساطیر آینده</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>
