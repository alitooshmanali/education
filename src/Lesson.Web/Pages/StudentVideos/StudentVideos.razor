@page "/student/videos"
@attribute [Authorize(Roles = nameof(UserRole.Student))]
@inject IVideoService Videos
@inject ICurrentUserContext CurrentUser

<PageHeader Eyebrow="Student" Title="درس‌ها" Subtitle="فقط ویدیوهای مجاز شما" />

<section class="panel pad">
    <div class="toolbar">
        <SearchInput Label="جستجو" Placeholder="عنوان یا مسیر" Value="@_query" ValueChanged="OnSearch" />
    </div>

    <DataTable TItem="VideoDto" Items="_filtered" Columns="_columns">
        <ActionsTemplate Context="video">
            <a class="btn btn-secondary" href="@($"/student/videos/{video.Id}")"><AppIcon Name="play" /> پخش</a>
        </ActionsTemplate>
    </DataTable>

    @if (!_filtered.Any())
    {
        <EmptyState Icon="video" Title="یافت نشد" Message="عبارت جستجو را تغییر دهید یا با ادمین برای تخصیص دسترسی تماس بگیرید." />
    }
</section>

@code {
    private IReadOnlyList<VideoDto> _videos = [];
    private IReadOnlyList<VideoDto> _filtered = [];
    private string _query = string.Empty;

    private readonly IReadOnlyList<TableColumn<VideoDto>> _columns =
    [
        new() { Header = "عنوان", Template = v => (RenderFragment)(b => b.AddContent(0, v.DisplayName)) },
        new() { Header = "مسیر", Template = v => (RenderFragment)(b =>
            {
                b.OpenElement(0, "span");
                b.AddAttribute(1, "class", "ltr");
                b.AddContent(2, v.FolderPath);
                b.CloseElement();
            }) },
        new() { Header = "حجم", Template = v => (RenderFragment)(b => b.AddContent(0, FormatSize(v.FileSize))) }
    ];

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.UserId is null)
        {
            return;
        }

        _videos = await Videos.GetForUserAsync(CurrentUser.UserId.Value, false);
        _filtered = _videos;
    }

    private void OnSearch(string value)
    {
        _query = value;
        _filtered = string.IsNullOrWhiteSpace(value)
            ? _videos
            : _videos.Where(v => v.DisplayName.Contains(value, StringComparison.OrdinalIgnoreCase) || v.FolderPath.Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private static string FormatSize(long size)
        => size > 1024 * 1024 * 1024 ? $"{size / 1024d / 1024d / 1024d:0.0} GB" :
           size > 1024 * 1024 ? $"{size / 1024d / 1024d:0.0} MB" :
           $"{size / 1024d:0.0} KB";
}
