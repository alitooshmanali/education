@page "/teacher/contents"
@attribute [Authorize(Roles = nameof(UserRole.Teacher))]
@inject IClassService Classes
@inject IContentService Contents
@inject ICurrentUserContext Current

<section class="page workspace-page teacher-page teacher-contents-page">
<div class="page-header">
    <h1>محتوا / داستان / پادکست</h1>
    <p class="muted">فقط برای کلاس‌های اختصاص‌یافته به شما. ادمین کلاس و سطح را تعریف می‌کند؛ بارگذاری محتوا با شماست.</p>
</div>

@if (_classes.Count == 0)
{
    <div class="alert alert-error">کلاسی ندارید.</div>
}
else
{
    @foreach (var c in _classes)
    {
        <div class="card pad" style="margin-bottom:16px">
            <h3>@c.Code — @c.Title <span class="pill">@c.Level</span></h3>
            <p class="muted" style="font-size:13px">@string.Join("، ", c.Days.Select(d => d.DayNameFa)) · @c.StartTime.ToString(@"hh\:mm")-@c.EndTime.ToString(@"hh\:mm")</p>
            @{
                var items = _contents.Where(x => x.Levels.Contains(c.Level)).ToList();
            }
            @if (items.Count == 0)
            {
                <p class="muted">هنوز محتوایی برای این سطح ثبت نشده.</p>
            }
            else
            {
                <ul>
                    @foreach (var it in items)
                    {
                        <li>@it.DisplayName (@it.Type)</li>
                    }
                </ul>
            }
        </div>
    }
}

</section>

@code {
    private List<ClassRoomDto> _classes = new();
    private List<ContentDto> _contents = new();

    protected override async Task OnInitializedAsync()
    {
        await Current.EnsureInitializedAsync();
        if (Current.UserId is not long uid) return;
        _classes = (await Classes.GetByTeacherAsync(uid)).ToList();
        var all = await Contents.GetAllAsync();
        var levels = _classes.Select(c => c.Level).ToHashSet();
        _contents = all.Where(c => c.Levels.Any(l => levels.Contains(l))).ToList();
    }
}
