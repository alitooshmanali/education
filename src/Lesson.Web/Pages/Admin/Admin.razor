@page "/admin"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject IUserService Users
@inject IContentService Contents
@inject IFolderService Folders
@inject IPermissionService Permissions

<PageHeader Eyebrow="Admin" Title="داشبورد مدیریت" Subtitle="خلاصه وضعیت سیستم" />

<section class="grid stats">
    <div class="stat-card">
        <div class="stat-label">کاربران</div>
        <div class="stat-value">@_users</div>
        <div class="stat-hint">کل حساب‌های فعال</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">محتوا</div>
        <div class="stat-value">@_contents</div>
        <div class="stat-hint">فایل‌های بارگذاری‌شده</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">گروه‌ها</div>
        <div class="stat-value">@_folders</div>
        <div class="stat-hint">گروه‌های منطقی</div>
    </div>
</section>

<section class="panel pad panel-spaced">
    <h3>دسترسی‌ها</h3>
    <p class="meta">تعداد کل دسترسی‌های فعال: <strong>@_permissions</strong></p>
    <ul class="admin-guide">
        <li>ساخت گروه و زیرگروه از بخش گروه‌ها</li>
        <li>بارگذاری محتوا (حداکثر ۲۰ مگابایت) در هر گروه</li>
        <li>اعطای دسترسی کاربر به گروه (ارث‌بری به زیرگروه‌ها)</li>
        <li>ردیابی رویدادهای ادمین از لاگ</li>
    </ul>
</section>

@code {
    private int _users;
    private int _contents;
    private int _folders;
    private int _permissions;

    protected override async Task OnInitializedAsync()
    {
        var allUsers = await Users.GetAllAsync();
        _users = allUsers.Count;

        var allContents = await Contents.GetAllAsync();
        _contents = allContents.Count;

        var tree = await Folders.GetTreeAsync();
        _folders = CountFolders(tree);

        var allPermissions = 0;
        foreach (var user in allUsers)
        {
            allPermissions += (await Permissions.GetForUserAsync(user.Id)).Count;
        }
        _permissions = allPermissions;
    }

    private static int CountFolders(IReadOnlyList<FolderNodeDto> nodes)
    {
        var n = 0;
        foreach (var node in nodes)
            n += 1 + CountFolders(node.Children);
        return n;
    }
}
