@page "/admin"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject IUserService Users
@inject IContentService Contents
@inject IFolderService Folders
@inject IPermissionService Permissions
@inject IFeedbackService Feedbacks
@inject IQuizService Quizzes
@inject IClassService Classes

<PageHeader Eyebrow="Admin" Title="داشبورد مدیریت" Subtitle="کلاس‌ها و مدرسان را ادمین تعریف می‌کند؛ محتوا و آزمون را مدرس هر کلاس." />

<div class="toolbar" style="margin-bottom:20px;display:flex;flex-wrap:wrap;gap:10px">
    <a class="btn btn-primary" href="/admin/classes">کلاس‌ها</a>
    <a class="btn btn-secondary" href="/admin/teachers">مدرسان</a>
    <a class="btn btn-secondary" href="/admin/schedule">برنامهٔ هفتگی</a>
    <a class="btn btn-ghost" href="/admin/users">کاربران</a>
    <a class="btn btn-ghost" href="/site/platform-admin.html">UI کامل ادمین</a>
</div>

<section class="grid stats">
    <div class="stat-card">
        <div class="stat-label">کاربران</div>
        <div class="stat-value">@_users</div>
        <div class="stat-hint">کل حساب‌های فعال</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">محتوا</div>
        <div class="stat-value">@_contents</div>
        <div class="stat-hint">فایل‌های بارگذاری‌شده</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">گروه‌ها</div>
        <div class="stat-value">@_folders</div>
        <div class="stat-hint">گروه‌های منطقی</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">آزمون‌ها</div>
        <div class="stat-value">@_quizzes</div>
        <div class="stat-hint">آزمون‌های تعریف‌شده</div>
    </div>
</section>

@if (_satisfaction is not null)
{
    <section class="grid two-col panel-spaced">
        <div class="panel pad gauge-card">
            <h3>رضایت دانشجویان</h3>
            <div class="gauge" style="--pct: @(_satisfaction.SatisfactionPercent)">
                <span>@_satisfaction.SatisfactionPercent%</span>
            </div>
            <p class="gauge-meta">
                میانگین امتیاز: @_satisfaction.AverageRating از ۵
                · @_satisfaction.TotalCount نظر
            </p>
            <p class="hint">
                راضی: @_satisfaction.SatisfiedCount ·
                خنثی: @_satisfaction.NeutralCount ·
                ناراضی: @_satisfaction.DissatisfiedCount
            </p>
        </div>
        <div class="panel pad">
            <h3>آخرین نظرات</h3>
            @if (_recentFeedback.Any())
            {
                <div class="panel-stack">
                    @foreach (var f in _recentFeedback.Take(8))
                    {
                        <div class="toolbar" style="justify-content:space-between;border-bottom:1px solid var(--color-border);padding-bottom:8px">
                            <div>
                                <strong>@f.Username</strong>
                                <span class="hint"> · @f.TargetType #@f.TargetId</span>
                                @if (!string.IsNullOrWhiteSpace(f.Comment))
                                {
                                    <p style="margin:4px 0 0;font-size:13px">@f.Comment</p>
                                }
                            </div>
                            <StatusBadge Text="@($"{f.Rating}/5")" Tone="@(f.Rating >= 4 ? "success" : f.Rating <= 2 ? "error" : "warning")" />
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="hint">هنوز نظری ثبت نشده است.</p>
            }
        </div>
    </section>
}

<section class="panel pad panel-spaced">
    <h3>راهنمای سریع</h3>
    <ul class="admin-guide">
        <li>هر دانشجو دقیقاً یک سطح (A1–C2) دارد</li>
        <li>هر پوشه متعلق به یک سطح است</li>
        <li>هنگام آپلود ویدیو، Folder و Level(ها) را مشخص کنید</li>
        <li>آزمون‌ها: مقدمه + آماده هستم + شمارنده + بازخورد فوری</li>
        <li>هر دانشجو یک‌بار در آزمون شرکت می‌کند مگر مجوز مجدد ادمین</li>
    </ul>
</section>

@code {
    private int _users;
    private int _contents;
    private int _folders;
    private int _quizzes;
    private SatisfactionSummaryDto? _satisfaction;
    private IReadOnlyList<FeedbackDto> _recentFeedback = [];

    protected override async Task OnInitializedAsync()
    {
        var allUsers = await Users.GetAllAsync();
        _users = allUsers.Count(u => u.IsActive);

        var allContents = await Contents.GetAllAsync();
        _contents = allContents.Count;

        var tree = await Folders.GetTreeAsync();
        _folders = CountFolders(tree);

        _quizzes = (await Quizzes.GetAllAsync()).Count;
        _satisfaction = await Feedbacks.GetSatisfactionSummaryAsync();
        _recentFeedback = await Feedbacks.GetAllAsync();
    }

    private static int CountFolders(IReadOnlyList<FolderNodeDto> nodes)
    {
        var n = 0;
        foreach (var node in nodes)
            n += 1 + CountFolders(node.Children);
        return n;
    }
}
