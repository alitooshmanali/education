@page "/admin"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject IUserService Users
@inject IVideoService Videos
@inject IFolderService Folders
@inject IPermissionService Permissions

<PageHeader Eyebrow="Admin" Title="داشبورد مدیریت" Subtitle="نمای کلی سیستم">
    <a class="btn btn-primary" href="/admin/videos"><AppIcon Name="upload" /> ارسال ویدیو</a>
</PageHeader>

<section class="grid stats">
    <StatCard Label="کاربران" Value="@_users.ToString()" Hint="پروفایل‌های فعال" Tone="neutral" />
    <StatCard Label="ویدیوها" Value="@_videos.ToString()" Hint="فایل‌های در دسترس" Tone="neutral" />
    <StatCard Label="پوشه‌ها" Value="@_folders.ToString()" Hint="ساختار مسیر" Tone="neutral" />
    <StatCard Label="دسترسی‌ها" Value="@_permissions.ToString()" Hint="اختصاص داده‌شده" Tone="neutral" />
</section>

<section class="content-grid content-grid--stacked panel-stack">
    <section class="panel pad panel-links">
        <h3>صفحات مدیریتی</h3>
        <div class="toolbar toolbar--flow">
            <a class="btn btn-secondary" href="/admin/users"><AppIcon Name="users" /> مدیریت کاربران</a>
            <a class="btn btn-secondary" href="/admin/folders"><AppIcon Name="folder" /> مدیریت پوشه‌ها</a>
            <a class="btn btn-secondary" href="/admin/videos"><AppIcon Name="video" /> مدیریت ویدیو</a>
            <a class="btn btn-secondary" href="/admin/permissions"><AppIcon Name="permission" /> مدیریت دسترسی</a>
            <a class="btn btn-secondary" href="/admin/devices"><AppIcon Name="device" /> مدیریت دستگاه‌ها</a>
            <a class="btn btn-secondary" href="/admin/audit"><AppIcon Name="audit" /> لاگ‌ها</a>
        </div>
    </section>

    <section class="panel pad">
        <h3>راهنمای سریع</h3>
        <p>ویدیوها از مسیر محافظت‌شده ارائه می‌شوند و تنها دانشجویان دارای مجوز نمایش داده می‌شوند.</p>
        <ul class="admin-guide">
            <li>آپلود فایل در مسیر پوشه</li>
            <li>اعطای دسترسی به پوشه برای پوشه‌های فرزند</li>
            <li>تعویض/باطل‌سازی دستگاه</li>
            <li>ردیابی رویدادهای ادمین از لاگ</li>
        </ul>
    </section>
</section>

@code {
    private int _users;
    private int _videos;
    private int _folders;
    private int _permissions;

    protected override async Task OnInitializedAsync()
    {
        _users = (await Users.GetAllAsync()).Count;
        _videos = (await Videos.GetAllAsync()).Count;
        _folders = (await Folders.GetTreeAsync()).Count;

        var allUsers = await Users.GetAllAsync();
        var allPermissions = 0;
        foreach (var user in allUsers)
        {
            var perms = await Permissions.GetForUserAsync(user.Id);
            allPermissions += perms.Count;
        }

        _permissions = allPermissions;
    }
}
