@page "/admin/site-courses"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject ISiteCourseService Courses
@inject IContentService Contents
@inject IFolderService Folders
@inject ICurrentUserContext Current

<style>
    .sc { max-width: 1100px; width: 100%; }
    .sc__head { display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; margin-bottom:16px; align-items:flex-start; }
    .sc__title { margin:0; font-size:24px; font-weight:900; color:#0A2B51; }
    .sc__sub { margin:4px 0 0; color:#6B7787; font-size:13px; }
    .sc-form { background:#fff; border:1px solid #E6E1D6; border-radius:16px; padding:16px; margin-bottom:14px; }
    .sc-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
    .sc-field label { display:block; font-size:12px; font-weight:700; color:#6B7787; margin-bottom:4px; }
    .sc-field input, .sc-field select, .sc-field textarea {
        width:100%; box-sizing:border-box; border:1px solid #E6E1D6; border-radius:10px; padding:9px 12px; font:inherit;
    }
    .sc-field.full { grid-column:1/-1; }
    .sc-card { background:#fff; border:1px solid #E6E1D6; border-radius:16px; overflow:hidden; }
    .sc-table { width:100%; border-collapse:collapse; font-size:13px; }
    .sc-table th { text-align:start; font-size:11px; font-weight:800; color:#6B7787; padding:10px 12px; background:#fbfaf7; border-bottom:1px solid #E6E1D6; }
    .sc-table td { padding:10px 12px; border-bottom:1px solid #eef1f5; vertical-align:middle; }
    .sc-alert { padding:10px 12px; border-radius:10px; margin-bottom:12px; font-size:13px; }
    .sc-alert.err { background:#fdecec; color:#8f2b21; }
    .sc-alert.ok { background:#e6f6f0; color:#0c5c41; }
    .sc-thumb { width:48px; height:36px; object-fit:cover; border-radius:6px; background:#f0eee8; }
    @@media (max-width:900px){ .sc-grid { grid-template-columns:1fr 1fr; } }
    @@media (max-width:560px){ .sc-grid { grid-template-columns:1fr; } }
</style>

<section class="sc">
    <div class="sc__head">
        <div>
            <h1 class="sc__title">دوره‌های سایت</h1>
            <p class="sc__sub">زبان · کامپیوتر · نقاشی · موسیقی</p>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button class="btn btn-ghost" type="button" disabled="@_busy" @onclick="ReactivateAllAsync">فعال‌سازی همه</button>
            <button class="btn btn-primary" type="button" @onclick="StartCreate">دوره جدید</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error)) { <div class="sc-alert err">@_error</div> }
    @if (!string.IsNullOrEmpty(_ok)) { <div class="sc-alert ok">@_ok</div> }

    @if (_showForm)
    {
        <div class="sc-form">
            <div class="sc-grid">
                <div class="sc-field full">
                    <label>عنوان</label>
                    <input @bind="_title" />
                </div>
                <div class="sc-field full">
                    <label>توضیح</label>
                    <textarea rows="2" @bind="_desc"></textarea>
                </div>
                <div class="sc-field">
                    <label>حوزه</label>
                    <select value="@_subject.ToString()" @onchange="OnSubjectChange">
                        @foreach (var s in Enum.GetValues<SubjectArea>())
                        {
                            <option value="@s.ToString()">@SubjectFa(s)</option>
                        }
                    </select>
                </div>
                <div class="sc-field">
                    <label>سطح</label>
                    <select value="@_level.ToString()" @onchange="OnLevelChange">
                        @foreach (var lv in Enum.GetValues<CourseOfferLevel>())
                        {
                            <option value="@lv.ToString()">@lv</option>
                        }
                    </select>
                </div>
                <div class="sc-field">
                    <label>شهریه (تومان)</label>
                    <input type="number" @bind="_tuition" />
                </div>
                <div class="sc-field">
                    <label>تعداد جلسه</label>
                    <input type="number" @bind="_sessions" />
                </div>
                <div class="sc-field">
                    <label>مدت هر جلسه (دقیقه)</label>
                    <input type="number" @bind="_duration" />
                </div>
                <div class="sc-field">
                    <label>ترتیب نمایش</label>
                    <input type="number" @bind="_sort" />
                </div>
                <div class="sc-field">
                    <label>تاریخ برگزاری (جلالی)</label>
                    <input @bind="_jalaliDate" placeholder="1404/08/15" dir="ltr" />
                </div>
                <div class="sc-field">
                    <label>ساعت (مثلاً 18:30)</label>
                    <input @bind="_jalaliTime" placeholder="18:30" dir="ltr" />
                </div>
                <div class="sc-field full">
                    <label>تصویر کارت</label>
                    <InputFile OnChange="OnImageFile" accept="image/*" />
                    @if (_imageId is long iid)
                    {
                        <div style="margin-top:8px"><img class="sc-thumb" src="/api/site/media/@iid" alt="" /></div>
                    }
                </div>
                <div class="sc-field full">
                    <label>ویدیو معرفی (اختیاری)</label>
                    <InputFile OnChange="OnVideoFile" accept="video/*" />
                    @if (_videoId is long vid)
                    {
                        <p style="margin:6px 0 0;font-size:12px;color:#6B7787">ویدیو ✓ #@vid</p>
                    }
                </div>
            </div>
            <div style="display:flex;gap:8px;margin-top:14px">
                <button class="btn btn-primary" type="button" disabled="@_busy" @onclick="SaveAsync">ذخیره</button>
                <button class="btn btn-ghost" type="button" @onclick="() => _showForm = false">لغو</button>
            </div>
        </div>
    }

    <div class="sc-card">
        <table class="sc-table">
            <thead>
                <tr>
                    <th></th>
                    <th>عنوان</th>
                    <th>حوزه</th>
                    <th>سطح</th>
                    <th>شهریه</th>
                    <th>شروع</th>
                    <th>فعال</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_items.Count == 0)
                {
                    <tr><td colspan="8" style="padding:20px;text-align:center;color:#6B7787">دوره‌ای ثبت نشده.</td></tr>
                }
                else
                {
                    @foreach (var it in _items)
                    {
                        <tr>
                            <td>
                                @if (it.ImageUrl is not null)
                                {
                                    <img class="sc-thumb" src="@it.ImageUrl" alt="" />
                                }
                            </td>
                            <td><strong>@it.Title</strong></td>
                            <td>@it.SubjectLabel</td>
                            <td>@it.LevelLabel</td>
                            <td>@it.TuitionAmount.ToString("N0")</td>
                            <td>@(it.StartsAtPersian ?? "—")</td>
                            <td>@(it.IsActive ? "بله" : "خیر")</td>
                            <td style="text-align:end;white-space:nowrap">
                                <button class="btn btn-sm btn-ghost" type="button" @onclick="() => StartEdit(it)">ویرایش</button>
                                <button class="btn btn-sm btn-outline" type="button" disabled="@_busy" @onclick="() => DeleteAsync(it.Id)">حذف</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private List<SiteCourseDto> _items = new();
    private bool _showForm, _busy;
    private long? _editId, _imageId, _videoId;
    private string _title = "", _desc = "", _jalaliDate = "", _jalaliTime = "";
    private SubjectArea _subject = SubjectArea.English;
    private CourseOfferLevel _level = CourseOfferLevel.A1;
    private decimal _tuition;
    private int _sessions = 12, _duration = 90, _sort;
    private string? _error, _ok;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload() => _items = (await Courses.GetAllAdminAsync()).ToList();

    private void StartCreate()
    {
        _editId = null;
        _title = ""; _desc = "";
        _subject = SubjectArea.English;
        _level = CourseOfferLevel.A1;
        _tuition = 0; _sessions = 12; _duration = 90; _sort = _items.Count;
        _jalaliDate = ""; _jalaliTime = "";
        _imageId = null; _videoId = null;
        _showForm = true; _error = _ok = null;
    }

    private void StartEdit(SiteCourseDto it)
    {
        _editId = it.Id;
        _title = it.Title;
        _desc = it.Description ?? "";
        _subject = it.Subject;
        _level = it.Level;
        _tuition = it.TuitionAmount;
        _sessions = it.SessionCount;
        _duration = it.SessionDurationMinutes ?? 90;
        _sort = it.SortOrder;
        _imageId = it.ImageContentId;
        _videoId = it.VideoContentId;
        if (it.StartsAt is { } st)
        {
            // نمایش ساده — ادمین می‌تواند دوباره وارد کند
            _jalaliDate = it.StartsAtPersian?.Split('،').FirstOrDefault()?.Trim() ?? "";
            _jalaliTime = "";
        }
        else { _jalaliDate = ""; _jalaliTime = ""; }
        _showForm = true; _error = _ok = null;
    }

    private void OnSubjectChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<SubjectArea>(e.Value?.ToString(), out var s))
            _subject = s;
    }

    private void OnLevelChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<CourseOfferLevel>(e.Value?.ToString(), out var lv))
            _level = lv;
    }

    private DateTimeOffset? ParseStarts()
    {
        if (string.IsNullOrWhiteSpace(_jalaliDate)) return null;
        return Lesson.Domain.PersianDate.ParseJalaliToUtc(_jalaliDate, _jalaliTime);
    }

    private async Task SaveAsync()
    {
        _error = _ok = null;
        if (string.IsNullOrWhiteSpace(_title)) { _error = "عنوان لازم است."; return; }
        _busy = true;
        try
        {
            await Courses.UpsertAsync(
                id: _editId,
                title: _title.Trim(),
                description: string.IsNullOrWhiteSpace(_desc) ? null : _desc.Trim(),
                subject: _subject,
                level: _level,
                tuitionAmount: _tuition,
                sessionCount: _sessions,
                sessionDurationMinutes: _duration > 0 ? _duration : null,
                startsAt: ParseStarts(),
                imageContentId: _imageId,
                videoContentId: _videoId,
                sortOrder: _sort,
                isActive: true);
            _ok = "ذخیره شد.";
            _showForm = false;
            await Reload();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(long id)
    {
        _error = _ok = null;
        _busy = true;
        try
        {
            await Courses.HardDeleteAsync(id);
            _ok = "حذف شد.";
            await Reload();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OnImageFile(InputFileChangeEventArgs e)
        => await UploadAndAttachAsync(e, ContentType.Image, 12 * 1024 * 1024, isImage: true);

    private async Task OnVideoFile(InputFileChangeEventArgs e)
        => await UploadAndAttachAsync(e, ContentType.Video, 200 * 1024 * 1024, isImage: false);

    private async Task UploadAndAttachAsync(InputFileChangeEventArgs e, ContentType type, long max, bool isImage)
    {
        _error = _ok = null;
        var file = e.File;
        if (file is null) return;
        if (file.Size <= 0) { _error = "فایل خالی است."; return; }
        if (file.Size > max) { _error = "حجم فایل زیاد است."; return; }
        _busy = true;
        try
        {
            if (_editId is null)
            {
                if (string.IsNullOrWhiteSpace(_title))
                    _title = "دوره جدید";
                var created = await Courses.UpsertAsync(
                    id: null,
                    title: _title.Trim(),
                    description: string.IsNullOrWhiteSpace(_desc) ? null : _desc.Trim(),
                    subject: _subject,
                    level: _level,
                    tuitionAmount: _tuition,
                    sessionCount: _sessions,
                    sessionDurationMinutes: _duration > 0 ? _duration : null,
                    startsAt: ParseStarts(),
                    imageContentId: _imageId,
                    videoContentId: _videoId,
                    sortOrder: _sort,
                    isActive: true);
                _editId = created.Id;
            }

            var folder = await Folders.GetSystemFolderAsync(Lesson.Domain.SystemFolders.PageSiteImages);
            await using var stream = file.OpenReadStream(maxAllowedSize: max);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            var req = new UploadContentRequest(folder.Id, file.Name, file.Name, ms, ms.Length, new[] { LanguageLevel.A1 }, type);
            var entity = await Contents.UploadAsync(req, Current.UserId, isAdmin: true);
            if (isImage) _imageId = entity.Id;
            else _videoId = entity.Id;

            await Courses.UpsertAsync(
                id: _editId,
                title: _title.Trim(),
                description: string.IsNullOrWhiteSpace(_desc) ? null : _desc.Trim(),
                subject: _subject,
                level: _level,
                tuitionAmount: _tuition,
                sessionCount: _sessions,
                sessionDurationMinutes: _duration > 0 ? _duration : null,
                startsAt: ParseStarts(),
                imageContentId: _imageId,
                videoContentId: _videoId,
                sortOrder: _sort,
                isActive: true);

            _ok = isImage ? "تصویر ذخیره و به دوره متصل شد." : "ویدیو ذخیره و به دوره متصل شد.";
            await Reload();
        }
        catch (Exception ex) { _error = "خطا در آپلود: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task ReactivateAllAsync()
    {
        _error = _ok = null;
        _busy = true;
        try
        {
            var n = 0;
            foreach (var it in _items.Where(x => !x.IsActive).ToList())
            {
                await Courses.UpsertAsync(
                    id: it.Id,
                    title: it.Title,
                    description: it.Description,
                    subject: it.Subject,
                    level: it.Level,
                    tuitionAmount: it.TuitionAmount,
                    sessionCount: it.SessionCount,
                    sessionDurationMinutes: it.SessionDurationMinutes,
                    startsAt: it.StartsAt,
                    imageContentId: it.ImageContentId,
                    videoContentId: it.VideoContentId,
                    sortOrder: it.SortOrder,
                    isActive: true);
                n++;
            }
            await Reload();
            _ok = n > 0 ? $"{n} دوره فعال شد." : "همه دوره‌ها فعال هستند.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static string SubjectFa(SubjectArea s) => s switch
    {
        SubjectArea.English => "زبان انگلیسی",
        SubjectArea.Computer => "کامپیوتر",
        SubjectArea.Painting => "نقاشی",
        SubjectArea.Music => "موسیقی",
        _ => s.ToString()
    };
}
