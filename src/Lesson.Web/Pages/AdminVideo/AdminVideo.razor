@page "/admin/videos/{VideoId:long}"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject IVideoService Videos

<PageHeader Eyebrow="Admin" Title="پخش ویدیو" Subtitle="مشاهده ویدیو برای مدیریت">
    <a class="btn btn-ghost" href="/admin/videos"><AppIcon Name="video" /> بازگشت</a>
</PageHeader>

@if (_video is null)
{
    <EmptyState Icon="video" Title="در دسترس نیست" Message="این ویدیو قابل پخش نیست یا حذف شده است.">
        <Action>
            <a class="btn btn-primary" href="/admin/videos">بازگشت</a>
        </Action>
    </EmptyState>
}
else
{
    <section class="media-shell">
        <section class="video-player-shell panel pad">
            <div class="video-info">
                <h3>@_video.DisplayName</h3>
                <div class="meta ltr">@_video.FolderPath</div>
                <p class="meta">نوع: @(_video.FileExtension.ToUpperInvariant()) — حجم: @FormatSize(_video.FileSize)</p>
            </div>

            <VideoPlayer StreamUrl="@($"/api/videos/{VideoId}/stream")" PosterUrl="" />
        </section>

        <section class="panel pad">
            <h4>شناسه ویدیو</h4>
            <p class="meta">@_video.Id</p>
            <p class="meta">نام فایل: <span class="ltr">@_video.FileName</span></p>
        </section>
    </section>
}

@code {
    [Parameter] public long VideoId { get; set; }
    private VideoDto? _video;

    protected override async Task OnInitializedAsync()
    {
        var all = await Videos.GetAllAsync();
        _video = all.FirstOrDefault(x => x.Id == VideoId);
    }

    private static string FormatSize(long size)
        => size > 1024 * 1024 * 1024 ? $"{size / 1024d / 1024d / 1024d:0.0} GB" :
           size > 1024 * 1024 ? $"{size / 1024d / 1024d:0.0} MB" :
           $"{size / 1024d:0.0} KB";
}
