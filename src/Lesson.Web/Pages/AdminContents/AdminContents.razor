@page "/admin/videos"
@page "/admin/contents"
@page "/admin/media"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject IContentService Contents
@inject IFolderService Folders
@inject MediaAssetCatalog MediaCatalog

<PageHeader Eyebrow="Admin · Media Center" Title="مرکز یکپارچه رسانه و محتوا" Subtitle="یک مخزن برای تصویر، ویدئو، صوت و فایل‌های آموزشی؛ مقصد انتشار را هنگام بارگذاری مشخص کنید." />

<section class="grid two-col">
    <section class="panel pad">
        <div class="toolbar">
            <h3>فهرست محتوا</h3>
            <SearchInput Label="جستجو" Placeholder="عنوان یا مسیر" Value="@_query" ValueChanged="OnSearch" />
        </div>

        <div class="toolbar">
            <select class="form-select" @bind="_folderFilterIdString">
                <option value="">همه گروه‌ها</option>
                @foreach (var folder in _folderOptions)
                {
                    <option value="@folder.Id">@folder.RelativePath</option>
                }
            </select>
            <button class="btn btn-outline" type="button" @onclick="ApplyFilters">اعمال فیلتر</button>
        </div>

        <DataTable TItem="ContentDto" Items="_filtered" Columns="_columns"
                   Loading="_isLoading" ErrorMessage="_loadError" OnRetry="RetryReloadAsync"
                   HasSourceItems="@(_items.Count > 0)" NoResultsTitle="رسانه‌ای با این فیلتر پیدا نشد"
                   NoResultsMessage="عبارت جست‌وجو یا پوشه مقصد را تغییر دهید." OnClearFilters="ClearFilters"
                   EmptyTitle="هنوز محتوایی بارگذاری نشده است" EmptyMessage="اولین تصویر، ویدئو، صوت یا سند را بارگذاری کنید.">
            <EmptyAction><a class="btn btn-primary" href="#media-upload">بارگذاری محتوای جدید</a></EmptyAction>
            <ActionsTemplate Context="item">
                <a class="btn btn-secondary" href="/api/admin/contents/@item.Id/download"><AppIcon Name="download" /> دانلود</a>
                <a class="btn btn-ghost" href="/admin/contents/@item.Id"><AppIcon Name="play" /> مشاهده</a>
                <button class="btn btn-outline" type="button" @onclick="() => OpenMove(item)">جابجایی</button>
                <button class="btn btn-danger" type="button" @onclick="() => ConfirmDelete(item)">حذف</button>
            </ActionsTemplate>
        </DataTable>
    </section>

    <section class="panel pad" id="media-upload">
        <h3>بارگذاری جدید</h3>
        <p class="hint">حداکثر حجم: ۲۰۰ مگابایت — تصویر، ویدئو، صوت و اسناد.</p>

        @if (_statusMessage is not null)
        {
            <div class="alert alert-success">@_statusMessage</div>
        }
        @if (_errorMessage is not null)
        {
            <div class="alert alert-error">@_errorMessage</div>
        }

        <div class="form-grid">
            <div class="field">
                <label>فایل</label>
                <InputFile OnChange="OnFileSelected" disabled="@_isBusy" />
                @if (_selectedFile is not null)
                {
                    <p class="hint">@_selectedFile.Name — @FormatSize(_selectedFile.Size)</p>
                }
            </div>

            <div class="field">
                <label>نام نمایش</label>
                <input @bind="_displayName" placeholder="مثلاً Family Lesson 01" disabled="@_isBusy" />
            </div>

            <div class="field">
                <label>محل استفاده از رسانه</label>
                <select value="@_uploadDestination" @onchange="OnUploadDestinationChanged" disabled="@_isBusy">
                    <option value="platform">پلتفرم آموزشی (کلاس‌ها و محتوای مدرس/دانش‌آموز)</option>
                    <option value="site:home">وب‌سایت · صفحه اصلی</option>
                    <option value="site:english">وب‌سایت · صفحه انگلیسی</option>
                    <option value="site:english-videos">وب‌سایت · فیلم‌های آموزشی انگلیسی</option>
                    <option value="site:english-podcast">وب‌سایت · پادکست انگلیسی</option>
                    <option value="site:english-stories">وب‌سایت · داستان‌های انگلیسی</option>
                    <option value="site:english-music">وب‌سایت · موسیقی انگلیسی</option>
                    <option value="site:english-books">وب‌سایت · کتاب‌های انگلیسی</option>
                    <option value="site:painting">وب‌سایت · نقاشی</option>
                    <option value="site:computer">وب‌سایت · کامپیوتر</option>
                    <option value="site:music-skill">وب‌سایت · آموزش موسیقی</option>
                    <option value="site:books">وب‌سایت · کتاب‌های فروشگاه</option>
                    <option value="site:courses">وب‌سایت · دوره‌ها</option>
                    <option value="site:placement">وب‌سایت · تعیین سطح</option>
                </select>
                <span class="hint">فایل در مخزن مرکزی ذخیره می‌شود و شناسه آن برای اتصال به صفحه یا محتوای مربوط استفاده خواهد شد.</span>
            </div>
            @if (_uploadDestination == "platform")
            {
                <div class="field">
                    <label>پوشه آموزشی مقصد</label>
                    <select @bind="_uploadFolderIdString" disabled="@_isBusy">
                        <option value="">انتخاب پوشه</option>
                        @foreach (var folder in _folderOptions.Where(x => !IsSystemPath(x.RelativePath)))
                        {
                            <option value="@folder.Id">[@folder.Level] @folder.RelativePath</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="note note--info">مقصد انتخاب‌شده به‌صورت خودکار به پوشه رسانه وب‌سایت متصل می‌شود. پس از بارگذاری، شناسه رسانه را در صفحه مدیریت مربوط انتخاب کنید.</div>
            }

            @if (_uploadDestination == "platform")
            {
            <div class="field">
                <label>سطح‌های نمایش (حداقل یکی)</label>
                <div class="level-checks">
                    @foreach (var lv in Enum.GetValues<LanguageLevel>())
                    {
                        <label class="check-inline">
                            <input type="checkbox" checked="@_uploadLevels.Contains(lv)"
                                   @onchange="e => ToggleUploadLevel(lv, (bool)(e.Value ?? false))" disabled="@_isBusy" />
                            @lv
                        </label>
                    }
                </div>
            </div>
            }
        </div>

        @if (_isBusy || _uploadPercent > 0)
        {
            <div class="upload-progress panel-spaced">
                <div class="upload-progress__label">
                    <span>@_uploadPhase</span>
                    <strong>@_uploadPercent%</strong>
                </div>
                <div class="upload-progress__track">
                    <div class="upload-progress__fill" style="width: @(_uploadPercent)%"></div>
                </div>
                <p class="hint">@FormatSize(_bytesTransferred) از @FormatSize(_bytesTotal)</p>
            </div>
        }

        <div class="toolbar">
            <button class="btn btn-primary" type="button" @onclick="UploadAsync"
                    disabled="@(string.IsNullOrWhiteSpace(_displayName) || _selectedFile is null || string.IsNullOrWhiteSpace(_uploadFolderIdString) || (_uploadDestination == "platform" && _uploadLevels.Count == 0) || _isBusy)">
                بارگذاری
            </button>
            @if (_isBusy)
            {
                <button class="btn btn-danger" type="button" @onclick="CancelUpload">انصراف</button>
            }
            else
            {
                <button class="btn btn-ghost" type="button" @onclick="ResetUpload">پاک‌سازی</button>
            }
        </div>

        @if (_movingItem is not null)
        {
            <hr class="panel-divider" />
            <h4>جابجایی محتوا</h4>
            <div class="form-grid">
                <div class="field">
                    <label>محتوا</label>
                    <input value="@_movingItem.DisplayName" disabled />
                </div>
                <div class="field">
                    <label>گروه جدید</label>
                    <select @bind="_moveFolderIdString">
                        <option value="">انتخاب گروه</option>
                        @foreach (var folder in _folderOptions)
                        {
                            <option value="@folder.Id">@folder.RelativePath</option>
                        }
                    </select>
                </div>
            </div>
            <div class="toolbar">
                <button class="btn btn-primary" type="button" @onclick="MoveAsync" disabled="@(string.IsNullOrWhiteSpace(_moveFolderIdString) || _isBusy)">انتقال</button>
                <button class="btn btn-ghost" type="button" @onclick="() => _movingItem = null">لغو</button>
            </div>
        }
    </section>
</section>

<ConfirmDialog IsOpen="_showDeleteConfirm"
               Title="حذف محتوا"
               Message="آیا حذف این محتوا را تایید می‌کنید؟"
               ConfirmText="حذف"
               Busy="_isBusy"
               OnClose="CancelDelete"
               OnConfirm="DeleteConfirmed" />

@code {
    private const long MaxUploadBytes = 200L * 1024 * 1024;

    private IReadOnlyList<ContentDto> _items = [];
    private IReadOnlyList<ContentDto> _filtered = [];
    private IReadOnlyList<FolderFlat> _folderOptions = [];
    private string _query = string.Empty;
    private string _folderFilterIdString = string.Empty;
    private string _uploadFolderIdString = string.Empty;
    private string _moveFolderIdString = string.Empty;
    private string _displayName = string.Empty;
    private string _uploadDestination = "platform";
    private HashSet<LanguageLevel> _uploadLevels = new();
    private IBrowserFile? _selectedFile;
    private ContentDto? _movingItem;
    private string? _statusMessage;
    private string? _errorMessage;
    private string? _loadError;
    private bool _isBusy, _isLoading = true;
    private long? _deleteId;
    private bool _showDeleteConfirm;

    private int _uploadPercent;
    private long _bytesTransferred;
    private long _bytesTotal;
    private string _uploadPhase = "آماده";
    private CancellationTokenSource? _uploadCts;
    private long? _uploadedContentId;

    private readonly IReadOnlyList<TableColumn<ContentDto>> _columns =
    [
        new() { Header = "عنوان", Template = v => (RenderFragment)(b => b.AddContent(0, v.DisplayName)) },
        new() { Header = "مسیر", Template = v => (RenderFragment)(b => {
            b.OpenElement(0, "span");
            b.AddAttribute(1, "class", "ltr");
            b.AddContent(2, v.FolderPath);
            b.CloseElement();
        }) },
        new() { Header = "نوع", Template = v => (RenderFragment)(b => b.AddContent(0, v.Type.ToString())) },
        new() { Header = "سطح‌ها", Template = v => (RenderFragment)(b => b.AddContent(0, string.Join(", ", v.Levels))) },
        new() { Header = "حجم", Template = v => (RenderFragment)(b => b.AddContent(0, FormatSize(v.FileSize))) }
    ];

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private Task RetryReloadAsync() => ReloadAsync();

    private async Task ReloadAsync(bool clearMessages = true)
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            var folders = await Folders.GetTreeAsync();
            _folderOptions = Flatten(folders).ToList();
            await MediaCatalog.RefreshAsync();
            _items = await MediaCatalog.GetAsync();
            _filtered = _items;
            if (clearMessages)
            {
                _statusMessage = null;
                _errorMessage = null;
            }
        }
        catch
        {
            _loadError = "بارگذاری فهرست رسانه‌ها ناموفق بود. فایل‌های ذخیره‌شده حذف یا تغییر نکرده‌اند.";
        }
        finally { _isLoading = false; }
    }

    private void ClearFilters()
    {
        _query = string.Empty;
        _folderFilterIdString = string.Empty;
        ApplyFilters();
    }

    private async Task OnUploadDestinationChanged(ChangeEventArgs args)
    {
        _uploadDestination = args.Value?.ToString() ?? "platform";
        _uploadFolderIdString = string.Empty;
        if (_uploadDestination == "platform") return;

        var destination = _uploadDestination switch
        {
            "site:english-videos" => (SystemFolders.PageVideos, "English-Videos"),
            "site:english-podcast" => (SystemFolders.PagePodcast, "English-Podcast"),
            "site:english-stories" => (SystemFolders.PageStories, "English-Stories"),
            "site:english-music" => (SystemFolders.PagePodcast, "English-Music"),
            "site:placement" => (SystemFolders.PagePlacement, "Placement"),
            "site:english-books" => (SystemFolders.PageSiteImages, "English-Books"),
            "site:english" => (SystemFolders.PageSiteImages, "English"),
            "site:painting" => (SystemFolders.PageSiteImages, "Painting"),
            "site:computer" => (SystemFolders.PageSiteImages, "Computer"),
            "site:music-skill" => (SystemFolders.PageSiteImages, "Music-Skill"),
            "site:books" => (SystemFolders.PageSiteImages, "Site-Books"),
            "site:courses" => (SystemFolders.PageSiteImages, "Site-Courses"),
            _ => (SystemFolders.PageSiteImages, "Home")
        };

        try
        {
            var root = await Folders.GetSystemFolderAsync(destination.Item1);
            var folders = await Folders.GetFlatAsync();
            var target = folders.FirstOrDefault(x => x.ParentFolderId == root.Id &&
                string.Equals(x.Name, destination.Item2, StringComparison.OrdinalIgnoreCase));
            target ??= await Folders.CreateAsync(destination.Item2, root.Id, LanguageLevel.A1);
            _uploadFolderIdString = target.Id.ToString();
        }
        catch (Exception ex)
        {
            _errorMessage = "پوشه مقصد رسانه در دسترس نیست: " + ex.Message;
        }
    }

    private static bool IsSystemPath(string path) =>
        path.Contains("_Page", StringComparison.OrdinalIgnoreCase);

    private static IEnumerable<FolderFlat> Flatten(IEnumerable<FolderNodeDto> nodes)
    {
        foreach (var n in nodes)
        {
            yield return new FolderFlat(n.Id, n.RelativePath, n.Level);
            foreach (var c in Flatten(n.Children))
                yield return c;
        }
    }

    private void OnSearch(string q) { _query = q; ApplyFilters(); }

    private void ApplyFilters()
    {
        IEnumerable<ContentDto> result = _items;
        if (!string.IsNullOrWhiteSpace(_query))
            result = result.Where(v => v.DisplayName.Contains(_query, StringComparison.OrdinalIgnoreCase)
                                    || v.FolderPath.Contains(_query, StringComparison.OrdinalIgnoreCase));
        if (long.TryParse(_folderFilterIdString, out var folderId))
            result = result.Where(v => v.FolderId == folderId);
        _filtered = result.ToList();
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.FileCount > 0 ? e.File : null;
        if (_selectedFile is not null)
            _displayName = Path.GetFileNameWithoutExtension(_selectedFile.Name);
    }

    private void ToggleUploadLevel(LanguageLevel level, bool selected)
    {
        if (selected) _uploadLevels.Add(level);
        else _uploadLevels.Remove(level);
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null) { _errorMessage = "فایلی انتخاب نشده است."; return; }
        if (_uploadDestination == "platform" && _uploadLevels.Count == 0) { _errorMessage = "حداقل یک سطح زبانی انتخاب کنید."; return; }
        if (!long.TryParse(_uploadFolderIdString, out var folderId)) { _errorMessage = "گروه مقصد را انتخاب کنید."; return; }
        if (string.IsNullOrWhiteSpace(_displayName)) { _errorMessage = "نام نمایش را وارد کنید."; return; }
        if (_selectedFile.Size > MaxUploadBytes)
        {
            _errorMessage = $"حداکثر حجم مجاز ۲۰۰ مگابایت است. حجم فایل: {_selectedFile.Size / 1024d / 1024d:0.0} MB";
            return;
        }

        _uploadCts?.Cancel();
        _uploadCts?.Dispose();
        _uploadCts = new CancellationTokenSource();
        var ct = _uploadCts.Token;
        _uploadedContentId = null;

        try
        {
            _isBusy = true;
            _errorMessage = null;
            _statusMessage = null;
            _uploadPercent = 0;
            _bytesTransferred = 0;
            _bytesTotal = _selectedFile.Size;
            _uploadPhase = "در حال خواندن فایل...";
            await InvokeAsync(StateHasChanged);

            // Read file in chunks so UI can show progress and cancel works
            await using var input = _selectedFile.OpenReadStream(maxAllowedSize: MaxUploadBytes, cancellationToken: ct);
            await using var bufferStream = new MemoryStream(capacity: (int)Math.Min(_selectedFile.Size, MaxUploadBytes));

            var buffer = new byte[64 * 1024]; // 64 KB
            int read;
            while ((read = await input.ReadAsync(buffer.AsMemory(0, buffer.Length), ct)) > 0)
            {
                await bufferStream.WriteAsync(buffer.AsMemory(0, read), ct);
                _bytesTransferred += read;
                _uploadPercent = _bytesTotal > 0
                    ? (int)Math.Min(99, (_bytesTransferred * 100) / _bytesTotal)
                    : 0;
                _uploadPhase = "در حال بارگذاری...";
                await InvokeAsync(StateHasChanged);
            }

            ct.ThrowIfCancellationRequested();

            _uploadPhase = "در حال ذخیره در دیتابیس...";
            _uploadPercent = 99;
            await InvokeAsync(StateHasChanged);

            bufferStream.Position = 0;
            IReadOnlyList<LanguageLevel> uploadLevels = _uploadDestination == "platform"
                ? _uploadLevels.ToList()
                : new[] { LanguageLevel.A1 };
            var request = new UploadContentRequest(
                folderId,
                _selectedFile.Name,
                _displayName.Trim(),
                bufferStream,
                bufferStream.Length,
                uploadLevels);

            var entity = await Contents.UploadAsync(request, cancellationToken: ct);
            _uploadedContentId = entity.Id;

            ct.ThrowIfCancellationRequested();

            _uploadPercent = 100;
            _uploadPhase = "تمام شد";
            _statusMessage = "محتوا با موفقیت بارگذاری شد.";
            _errorMessage = null;
            ResetUploadFields();
            await ReloadAsync(clearMessages: false);
        }
        catch (OperationCanceledException)
        {
            await RollbackUploadedIfAny();
            _errorMessage = "بارگذاری لغو شد.";
            _statusMessage = null;
            _uploadPhase = "لغو شد";
            _uploadPercent = 0;
        }
        catch (Exception ex)
        {
            await RollbackUploadedIfAny();
            _errorMessage = ex.Message;
            _uploadPhase = "خطا";
        }
        finally
        {
            _isBusy = false;
            _bytesTransferred = 0;
            _bytesTotal = 0;
            _uploadCts?.Dispose();
            _uploadCts = null;
            _uploadedContentId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelUpload()
    {
        try { _uploadCts?.Cancel(); }
        catch { /* ignore */ }
    }

    private async Task RollbackUploadedIfAny()
    {
        if (_uploadedContentId is null) return;
        try
        {
            await Contents.DeleteAsync(_uploadedContentId.Value);
        }
        catch
        {
            // best effort
        }
        finally
        {
            _uploadedContentId = null;
        }
    }

    private void ResetUploadFields()
    {
        _selectedFile = null;
        _displayName = string.Empty;
        _uploadFolderIdString = string.Empty;
        _uploadDestination = "platform";
        _uploadPercent = 0;
        _uploadPhase = "آماده";
    }

    private void ResetUpload()
    {
        if (_isBusy) return;
        ResetUploadFields();
        _errorMessage = null;
        _statusMessage = null;
    }

    private void OpenMove(ContentDto item)
    {
        _movingItem = item;
        _moveFolderIdString = string.Empty;
        _errorMessage = null;
    }

    private async Task MoveAsync()
    {
        if (_movingItem is null) return;
        if (!long.TryParse(_moveFolderIdString, out var folderId)) { _errorMessage = "گروه مقصد را انتخاب کنید."; return; }
        try
        {
            _isBusy = true;
            await Contents.MoveAsync(_movingItem.Id, folderId);
            _statusMessage = "محتوا با موفقیت منتقل شد.";
            _movingItem = null;
            await ReloadAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _isBusy = false; }
    }

    private void ConfirmDelete(ContentDto item) { _deleteId = item.Id; _showDeleteConfirm = true; }

    private async Task DeleteConfirmed()
    {
        if (_deleteId is null) return;
        try
        {
            _isBusy = true;
            await Contents.DeleteAsync(_deleteId.Value);
            _statusMessage = "محتوا حذف شد.";
            await ReloadAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _isBusy = false; _showDeleteConfirm = false; _deleteId = null; }
    }

    private void CancelDelete() { _showDeleteConfirm = false; _deleteId = null; }

    private static string FormatSize(long size)
        => size > 1024 * 1024 * 1024 ? $"{size / 1024d / 1024d / 1024d:0.0} GB" :
           size > 1024 * 1024 ? $"{size / 1024d / 1024d:0.0} MB" :
           size > 0 ? $"{size / 1024d:0.0} KB" : "0 KB";

    private sealed record FolderFlat(long Id, string RelativePath, LanguageLevel Level);
}
