@page "/student/videos"
@attribute [Authorize(Roles = nameof(UserRole.Student))]
@inject IContentService Contents
@inject ICurrentUserContext CurrentUser

<PageHeader Eyebrow="Student" Title="درس‌ها" Subtitle="فقط محتوای مجاز شما" />

<section class="panel pad">
    <div class="toolbar">
        <SearchInput Label="جستجو" Placeholder="عنوان یا مسیر" Value="@_query" ValueChanged="OnSearch" />
    </div>

    <DataTable TItem="ContentDto" Items="_filtered" Columns="_columns">
        <ActionsTemplate Context="item">
            <a class="btn btn-secondary" href="@($"/student/videos/{item.Id}")"><AppIcon Name="play" /> باز کردن</a>
        </ActionsTemplate>
    </DataTable>

    @if (!_filtered.Any())
    {
        <EmptyState Icon="video" Title="یافت نشد" Message="عبارت جستجو را تغییر دهید یا با ادمین برای تخصیص دسترسی تماس بگیرید." />
    }
</section>

@code {
    private IReadOnlyList<ContentDto> _items = [];
    private IReadOnlyList<ContentDto> _filtered = [];
    private string _query = string.Empty;

    private readonly IReadOnlyList<TableColumn<ContentDto>> _columns =
    [
        new() { Header = "عنوان", Template = v => (RenderFragment)(b => b.AddContent(0, v.DisplayName)) },
        new() { Header = "مسیر", Template = v => (RenderFragment)(b =>
            {
                b.OpenElement(0, "span");
                b.AddAttribute(1, "class", "ltr");
                b.AddContent(2, v.FolderPath);
                b.CloseElement();
            }) },
        new() { Header = "نوع", Template = v => (RenderFragment)(b => b.AddContent(0, v.Type.ToString())) },
        new() { Header = "حجم", Template = v => (RenderFragment)(b => b.AddContent(0, FormatSize(v.FileSize))) }
    ];

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.UserId is null) return;

        _items = await Contents.GetForUserAsync(CurrentUser.UserId.Value, false);
        _filtered = _items;
    }

    private void OnSearch(string value)
    {
        _query = value;
        _filtered = string.IsNullOrWhiteSpace(value)
            ? _items
            : _items.Where(v =>
                v.DisplayName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                v.FolderPath.Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private static string FormatSize(long size)
        => size > 1024 * 1024 * 1024 ? $"{size / 1024d / 1024d / 1024d:0.0} GB" :
           size > 1024 * 1024 ? $"{size / 1024d / 1024d:0.0} MB" :
           $"{size / 1024d:0.0} KB";
}
