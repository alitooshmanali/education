@page "/teacher"
@attribute [Authorize(Roles = nameof(UserRole.Teacher))]
@inject TeacherSessionState Session
@inject ITeacherWorkspaceService Workspace
@inject ICurrentUserContext Current
@implements IDisposable

<section class="page">
    <PageHeader Title="داشبورد مدرس" Subtitle="سطح و کلاس از هدر انتخاب می‌شود؛ فقط دادهٔ همان کلاس بارگذاری می‌شود." />
    
    @if (Session.SelectedClassId is null)
    {
        <div class="card pad"><p class="muted">از هدر بالا سطح و کلاس را انتخاب کنید.</p></div>
    }
    else if (_dash is null)
    {
        <p class="muted">در حال بارگذاری…</p>
    }
    else
    {
        <section class="teacher-welcome panel-spaced">
            <div>
                <span class="eyebrow">پنل مدرس</span>
                <h2>کلاس انتخاب‌شده، مرکز فعالیت امروز توست</h2>
                <p>محتوا و گزارش‌ها بر اساس همان کلاسی نمایش داده می‌شوند که از سربرگ انتخاب کرده‌ای.</p>
            </div>
            <div class="teacher-welcome__mark" aria-hidden="true">آ</div>
        </section>
        <section class="grid stats">
            <StatCard Label="دانش‌آموزان سطح" Value="@_dash.StudentCount.ToString()" Icon="users" IconTone="navy" />
            <StatCard Label="پوشه‌ها" Value="@_dash.FolderCount.ToString()" Icon="folder" IconTone="gold" />
            <StatCard Label="ویدیوها" Value="@_dash.VideoCount.ToString()" Icon="video" IconTone="navy" />
            <StatCard Label="پادکست‌ها" Value="@_dash.PodcastCount.ToString()" Icon="audit" IconTone="violet" />
            <StatCard Label="داستان‌ها" Value="@_dash.StoryCount.ToString()" Icon="folder" IconTone="jade" />
            <StatCard Label="آزمون‌ها" Value="@_dash.QuizCount.ToString()" Icon="audit" IconTone="gold" />
        </section>
        <div class="toolbar" style="margin-top:20px;display:flex;flex-wrap:wrap;gap:10px">
            <a class="btn btn-primary" href="/teacher/folders">پوشه‌ها</a>
            <a class="btn btn-secondary" href="/teacher/videos">ویدیو</a>
            <a class="btn btn-secondary" href="/teacher/podcasts">پادکست</a>
            <a class="btn btn-secondary" href="/teacher/stories">داستان</a>
            <a class="btn btn-secondary" href="/teacher/quizzes">آزمون‌ها</a>
            <a class="btn btn-ghost" href="/teacher/students">دانش‌آموزان</a>
            <a class="btn btn-ghost" href="/teacher/reports">گزارش‌ها</a>
        </div>
    }
</section>

@code {
    private TeacherDashboardDto? _dash;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await LoadAsync();
    }

    private async void OnChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _dash = null;
        if (Current.UserId is long uid && Session.SelectedClassId is long cid)
            _dash = await Workspace.GetDashboardAsync(uid, cid);
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
