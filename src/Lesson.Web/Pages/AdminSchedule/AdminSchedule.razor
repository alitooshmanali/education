@page "/admin/schedule"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject IClassService Classes

<style>
    .sch { max-width: 1400px; width: 100%; }
    .sch__head { margin-bottom: 20px; }
    .sch__eyebrow { margin: 0; font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: var(--muted); text-transform: uppercase; }
    .sch__title { margin: 4px 0 6px; font-size: 26px; font-weight: 900; color: var(--ink); }
    .sch__sub { margin: 0; color: var(--muted); font-size: 13.5px; }
    .sch-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 12px; width: 100%; }
    .sch-day { background: var(--paper); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 2px 8px rgba(10,43,81,.05); min-height: 160px; display: flex; flex-direction: column; overflow: hidden; }
    .sch-day__head { padding: 12px 14px; border-bottom: 1px solid var(--line); background: linear-gradient(180deg, var(--sand-50), var(--paper)); display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .sch-day__head h3 { margin: 0; font-size: 14px; font-weight: 800; color: var(--navy-800); }
    .sch-day__cnt { font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 999px; background: var(--navy-50); color: var(--navy-800); }
    .sch-day__body { padding: 10px; flex: 1; display: flex; flex-direction: column; gap: 8px; }
    .sch-empty { margin: auto; font-size: 12px; color: var(--muted); text-align: center; padding: 16px 8px; }
    .sch-slot { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; background: var(--row-hover); border-inline-start: 3px solid var(--navy-800); }
    .sch-slot--noteach { border-inline-start-color: var(--amber); background: #fdf8ef; }
    .sch-slot__code { font-size: 12.5px; font-weight: 900; color: var(--navy-800); }
    .sch-slot__title { font-size: 12px; color: var(--ink-soft); margin-top: 2px; }
    .sch-slot__meta { font-size: 11px; color: var(--muted); margin-top: 6px; line-height: 1.6; }
    @@media (max-width: 1200px) { .sch-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    @@media (max-width: 720px) { .sch-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 420px) { .sch-grid { grid-template-columns: 1fr; } }
</style>

<section class="sch">
    <div class="sch__head">
        <p class="sch__eyebrow">ADMIN</p>
        <h1 class="sch__title">برنامهٔ هفتگی</h1>
        <p class="sch__sub">نمای تجمیعی کلاس‌ها بر اساس روز — تداخل مدرس هنگام ذخیره کنترل می‌شود.</p>
    </div>
    @if (_loading)
    {
        <LoadingState Skeleton="true" Rows="7" Title="در حال بارگذاری برنامه هفتگی" />
    }
    else if (_loadError is not null)
    {
        <ErrorState Title="برنامه هفتگی بارگذاری نشد" Message="@_loadError" OnRetry="ReloadAsync" />
    }
    else if (!_byDay.Values.Any(day => day.Count > 0))
    {
        <EmptyState Icon="calendar-days" Title="هنوز کلاسی در برنامه ثبت نشده است" Message="پس از ایجاد کلاس و تعیین روزهای برگزاری، برنامه هفتگی اینجا نمایش داده می‌شود.">
            <Action><a class="btn btn-primary" href="/admin/classes">مدیریت کلاس‌ها</a></Action>
        </EmptyState>
    }
    else
    {
    <div class="sch-grid">
        @for (var d = 0; d < 7; d++)
        {
            var day = d;
            var items = _byDay.GetValueOrDefault(day) ?? new List<ClassRoomDto>();
            <div class="sch-day">
                <div class="sch-day__head">
                    <h3>@_dayNames[day]</h3>
                    <span class="sch-day__cnt">@items.Count</span>
                </div>
                <div class="sch-day__body">
                    @if (items.Count == 0)
                    {
                        <p class="sch-empty">کلاسی نیست</p>
                    }
                    else
                    {
                        @foreach (var c in items.OrderBy(x => x.StartTime))
                        {
                            <div class="sch-slot @(c.TeacherId is null ? "sch-slot--noteach" : null)">
                                <div class="sch-slot__code">@c.Code</div>
                                <div class="sch-slot__title">@c.Title</div>
                                <div class="sch-slot__meta">
                                    @Fmt(c.StartTime) – @Fmt(c.EndTime)
                                    · @c.Level
                                    · @(c.TeacherUsername ?? "بدون مدرس")
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
    }
</section>

@code {
    private static readonly string[] _dayNames = ["یک‌شنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنج‌شنبه", "جمعه", "شنبه"];
    private Dictionary<int, List<ClassRoomDto>> _byDay = new();
    private bool _loading = true;
    private string? _loadError;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var all = (await Classes.GetAllAsync()).Where(c => c.Status != ClassStatus.Inactive).ToList();
            var byDay = Enumerable.Range(0, 7).ToDictionary(i => i, _ => new List<ClassRoomDto>());
            foreach (var c in all)
            {
                foreach (var d in c.Days)
                    byDay[d.DayOfWeek].Add(c);
            }
            _byDay = byDay;
        }
        catch { _loadError = "دریافت برنامه هفتگی ناموفق بود. دوباره تلاش کنید."; }
        finally { _loading = false; }
    }

    private static string Fmt(TimeSpan t) => $"{t.Hours:00}:{t.Minutes:00}";
}
