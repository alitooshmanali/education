@page "/admin/candidates"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@using Lesson.Domain
@inject ICandidateService Candidates

<style>
    .cand { max-width:var(--content-max-width); width:100%; }
    .cand__head { display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; margin-bottom:18px; align-items:flex-start; }
    .cand__title { margin:0; font-family:var(--font-display); font-size:24px; font-weight:900; color:var(--navy-800); }
    .cand__sub { margin:4px 0 0; color:var(--muted); font-size:13px; }
    .cand-card { background:var(--paper); border:1px solid var(--line); border-radius:var(--r-xl); overflow:hidden; box-shadow:var(--sh-1); }
    .cand-table { width:100%; border-collapse:collapse; font-size:13px; }
    .cand-table th { text-align:start; font-size:11px; font-weight:800; color:var(--muted); padding:12px 14px; background:var(--sand-50); border-bottom:1px solid var(--line); white-space:nowrap; }
    .cand-table td { padding:12px 14px; border-bottom:1px solid var(--line-cool); vertical-align:middle; }
    .cand-table tbody tr:hover td { background:var(--row-hover); }
    .cand-phone { display:inline-flex; align-items:center; gap:8px; font-weight:800; color:var(--navy-800); text-decoration:none; direction:ltr; unicode-bidi:isolate; font-family:var(--font-latin); }
    .cand-phone:hover { color:var(--sand-700); }
    .cand-call { display:inline-flex; align-items:center; justify-content:center; padding:7px 13px; border-radius:var(--r-pill); background:var(--navy-800); color:var(--paper); font-size:12px; font-weight:800; text-decoration:none; white-space:nowrap; transition:transform .16s var(--ease),box-shadow .16s var(--ease); }
    .cand-call:hover { transform:translateY(-1px); box-shadow:var(--sh-2); color:var(--paper); }
    .cand-pill { display:inline-flex; align-items:center; gap:6px; font-size:11px; font-weight:800; padding:4px 10px; border-radius:var(--r-pill); background:var(--navy-50); color:var(--navy-700); }
    .cand-pill.done { background:var(--jade-bg); color:var(--jade); }
    .cand-pill.started { background:var(--amber-bg); color:var(--amber); }
    .cand-score { font-weight:800; color:var(--navy-800); font-variant-numeric:tabular-nums; }
    .cand-date { white-space:nowrap; font-size:12px; color:var(--muted); }
    .cand-empty { padding:28px; text-align:center; color:var(--muted); }
    .cand-tools { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:14px; }
    .cand-tools input,.cand-tools select { border:1px solid var(--line); border-radius:var(--r-md); padding:9px 12px; font:inherit; background:var(--paper); color:var(--ink); }
    .cand-tools input { min-width:min(260px,100%); }
    .cand-tools input:focus,.cand-tools select:focus { outline:0; border-color:var(--sand-500); box-shadow:var(--ring); }
    .cand-summary { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-bottom:18px; }
    .cand-summary article { padding:16px 18px; border:1px solid var(--line); border-radius:var(--r-lg); background:var(--paper); box-shadow:var(--sh-1); }
    .cand-summary small { display:block; color:var(--muted); font-size:11.5px; font-weight:700; }
    .cand-summary strong { display:block; margin-top:3px; color:var(--navy-800); font-family:var(--font-display); font-size:26px; font-weight:900; font-variant-numeric:tabular-nums; }
    @@media (max-width:900px) {
        .cand-table thead { display:none; }
        .cand-table,.cand-table tbody { display:block; width:100%; }
        .cand-table tr { display:block; margin:10px; padding:10px 14px; border:1px solid var(--line); border-radius:var(--r-lg); background:var(--paper); box-shadow:var(--sh-1); }
        .cand-table td { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; border:0; border-bottom:1px solid var(--line-cool); padding:8px 0; text-align:start; }
        .cand-table td:last-child { border-bottom:0; }
        .cand-table td::before { content:attr(data-label); flex:0 0 34%; max-width:34%; color:var(--muted); font-size:11px; font-weight:800; }
    }
    @@media (max-width:560px) { .cand-summary { grid-template-columns:1fr 1fr; gap:9px; } .cand-summary article:last-child { grid-column:1/-1; } .cand__title { font-size:21px; } }
</style>

<section class="cand">
    <div class="cand__head">
        <div>
            <h1 class="cand__title">داوطلبان تعیین سطح</h1>
            <p class="cand__sub">شماره تماس و نمرات آزمون — برای پیگیری و تماس</p>
        </div>
        <button class="btn btn-ghost" type="button" disabled="@_busy" @onclick="Reload">بروزرسانی</button>
    </div>

    <div class="cand-summary" aria-label="خلاصه داوطلبان">
        <article><small>کل داوطلبان</small><strong>@_items.Count</strong></article>
        <article><small>تکمیل‌شده</small><strong>@_items.Count(x => string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase))</strong></article>
        <article><small>در حال انجام</small><strong>@_items.Count(x => string.Equals(x.Status, "Started", StringComparison.OrdinalIgnoreCase))</strong></article>
    </div>

    <div class="cand-tools">
        <input type="tel" inputmode="numeric" dir="ltr" aria-label="جستجوی شماره داوطلب" placeholder="جستجوی شماره..." @bind="_q" @bind:event="oninput" />
        <select @bind="_statusFilter">
            <option value="">همه وضعیت‌ها</option>
            <option value="Completed">تکمیل‌شده</option>
            <option value="Started">شروع‌شده</option>
        </select>
    </div>

    <div class="cand-card">
        @if (_busy && _items.Count == 0)
        {
            <div class="cand-empty">در حال بارگذاری…</div>
        }
        else if (Filtered.Count == 0)
        {
            <div class="cand-empty">داوطلبی با این فیلتر پیدا نشد. عبارت جست‌وجو یا وضعیت را تغییر بده.</div>
        }
        else
        {
            <table class="cand-table">
                <thead>
                    <tr>
                        <th>تماس</th>
                        <th>سطح پیشنهادی</th>
                        <th>شنیداری</th>
                        <th>خواندن</th>
                        <th>نوشتاری/گفتاری</th>
                        <th>واژگان</th>
                        <th>جمع</th>
                        <th>وضعیت</th>
                        <th>تاریخ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Filtered)
                    {
                        <tr>
                            <td data-label="تماس">
                                <a class="cand-phone" href="tel:@c.PhoneNumber" dir="ltr">@c.PhoneNumber</a>
                            </td>
                            <td data-label="سطح"><span class="cand-pill">@(c.SuggestionLevel ?? "—")</span></td>
                            <td data-label="شنیداری" class="cand-score">@Fmt(c.ListeningScore)</td>
                            <td data-label="خواندن" class="cand-score">@Fmt(c.ReadingScore)</td>
                            <td data-label="نوشتاری" class="cand-score">@Fmt(c.WritingScore)</td>
                            <td data-label="واژگان" class="cand-score">@Fmt(c.VocabularyScore)</td>
                            <td data-label="جمع" class="cand-score">@Fmt(c.TotalScore)</td>
                            <td data-label="وضعیت">
                                <span class="cand-pill @StatusClass(c.Status)">@StatusFa(c.Status)</span>
                            </td>
                            <td data-label="تاریخ" class="cand-date">
                                @PersianDate.Format(c.CreatedAt)
                                @if (c.CompletedAt is { } done)
                                {
                                    <div>اتمام: @PersianDate.Format(done)</div>
                                }
                            </td>
                            <td data-label="اقدام">
                                <a class="cand-call" href="tel:@c.PhoneNumber">تماس</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

@code {
    private List<CandidateUserAdminDto> _items = new();
    private bool _busy;
    private string _q = "";
    private string _statusFilter = "";

    private IReadOnlyList<CandidateUserAdminDto> Filtered
    {
        get
        {
            IEnumerable<CandidateUserAdminDto> q = _items;
            if (!string.IsNullOrWhiteSpace(_q))
            {
                var s = _q.Trim();
                q = q.Where(x => x.PhoneNumber.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(_statusFilter))
                q = q.Where(x => string.Equals(x.Status, _statusFilter, StringComparison.OrdinalIgnoreCase));
            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _busy = true;
        try { _items = (await Candidates.GetAllAdminAsync()).ToList(); }
        finally { _busy = false; }
    }

    private static string Fmt(decimal? v) => v is null ? "—" : v.Value.ToString("0.#");

    private static string StatusFa(string? s) => s switch
    {
        "Completed" => "تکمیل‌شده",
        "Started" => "شروع‌شده",
        _ => s ?? "—"
    };

    private static string StatusClass(string? s) => s switch
    {
        "Completed" => "done",
        "Started" => "started",
        _ => ""
    };
}
